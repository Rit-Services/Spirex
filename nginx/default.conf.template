# Rendered at CONTAINER START, not at build time.
#
# The official nginx image runs /docker-entrypoint.d/20-envsubst-on-templates.sh,
# which envsubst's every *.template in /etc/nginx/templates/ into /etc/nginx/conf.d/.
# That is what lets ONE published image work in compose, Kubernetes, Portainer, or
# behind someone else's reverse proxy without a rebuild.
#
# CRITICAL: client/Dockerfile sets NGINX_ENVSUBST_FILTER=^SPIREX_ so ONLY our
# SPIREX_* vars are substituted. Without that filter envsubst would also eat
# nginx's own runtime variables ($uri, $host, $request_uri, $scheme, ...) and
# blank them out — a silently broken proxy. Every var added here MUST be
# SPIREX_-prefixed.
server {
  listen 80;
  server_name _;

  # Docker's embedded DNS is 127.0.0.11. It MUST be overridable: proxy_pass below
  # contains a variable, which makes nginx resolve the upstream at RUNTIME through
  # this resolver — so on Kubernetes (where 127.0.0.11 does not exist) every /api
  # request fails until this points at the cluster DNS service.
  resolver ${SPIREX_DNS_RESOLVER} valid=30s;

  # Must accommodate the largest accepted upload (videos up to 300 MB —
  # see server/middlewares/uploadHandler.ts). Default 1 MB would 413
  # video uploads before they ever reach Express.
  client_max_body_size ${SPIREX_MAX_BODY_SIZE};

  root /usr/share/nginx/html;
  index index.html;

  # Fingerprinted build assets (Vite hashes the filename on every content
  # change) are safe to cache forever. `try_files … =404` is the IMPORTANT bit:
  # a MISSING asset must return a real 404, NOT fall back to index.html — that
  # fallback is what makes a stale client receive HTML for a .js request and
  # throw "Expected a JavaScript module but got MIME type text/html".
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # NEVER cache the HTML shell. It's tiny and points at the current asset
  # hashes; serving it stale is exactly what strands a browser on a deleted
  # bundle after a deploy. Forcing revalidation makes clients self-heal on the
  # next load instead of needing a manual hard-refresh.
  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate";
    expires -1;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }

  # SPIREX_API_UPSTREAM is host:port of the API — `server:4000` under the bundled
  # compose file, `spirex-server:4000` on a stack that names the service
  # differently, or any reachable address.
  location /api/ {
    proxy_pass http://${SPIREX_API_UPSTREAM}$request_uri;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Large video uploads can take a while on slower connections.
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }
}
