# ── Core ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://spirex:spirex@localhost:5432/spirex
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
# Encrypts stored third-party secrets (e.g. saved JIRA API tokens) at rest.
# Falls back to JWT_SECRET if unset; set a dedicated value in production so
# rotating JWT_SECRET doesn't orphan saved tokens. openssl rand -hex 32
ENCRYPTION_KEY=
PORT=4000
CLIENT_URL=http://localhost:5173
# Auth-cookie Secure flag. Auto: ON when CLIENT_URL is https://, OFF for http://.
# A Secure cookie is never sent over plain HTTP, so leave this OFF unless you
# actually serve over HTTPS. Force with true/false.
COOKIE_SECURE=
LOG_LEVEL=info
NODE_ENV=development
# Default per-file cap for images/documents (25 MB).
MAX_UPLOAD_BYTES=26214400
# Larger cap reserved for video uploads (screen recordings). Default 300 MB.
MAX_VIDEO_UPLOAD_BYTES=314572800

# ── First-run admin (bootstrap) ─────────────────────────────────────────────
# On first boot with an EMPTY database, SPIREX creates ONE admin account from
# these values, plus the organization it administers. Once any user exists this
# is IGNORED — change the password in-app afterward, not here. The admin can then
# invite the rest of the team from the Users page.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=Admin
DEFAULT_ORG_NAME=SPIREX
DEFAULT_ORG_SLUG=default

# ── Attachment storage ──────────────────────────────────────────────────────
#   local (default) → files on disk under UPLOADS_DIR
#   minio / s3      → S3-compatible object store (MinIO, AWS S3, ...)
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads

# MinIO / S3 — only required when STORAGE_DRIVER=minio (or s3). The bucket must
# already exist. For MinIO keep MINIO_FORCE_PATH_STYLE=true (default). For AWS
# S3 set MINIO_FORCE_PATH_STYLE=false and a real MINIO_REGION.
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=spirex
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable sending — invite links are still created and
# returned in the API response so an admin can copy/paste them.
# Gmail / Google Workspace example (use an App Password, NOT your login password):
#   https://support.google.com/accounts/answer/185833
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=<your-gmail-address>  SMTP_PASSWORD=<16-char app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SPIREX <no-reply@example.com>"
INVITE_TTL_HOURS=168

# Inbound feedback webhook (POST /api/webhooks/feedback). External feedback
# lands as type=bug stories in this project, authored by the feedback-bot user.
# Leave blank to leave the webhook effectively unused.
FEEDBACK_DEFAULT_PROJECT_KEY=
FEEDBACK_BOT_EMAIL=feedback-bot@example.com

# Shared secret for internal endpoints (e.g. the weekly-digest trigger). Blank
# disables them.
INTERNAL_API_TOKEN=

# ── Microsoft SSO (OIDC) ────────────────────────────────────────────────────
# Sign in with Microsoft Entra ID. OFF until BOTH client id and secret are set
# (blank = password login only). SSO never creates users (invite-only); it
# authenticates existing accounts by the immutable Entra `oid`.
#   MS_TENANT_ID: a directory (tenant) id locks sign-in to that one tenant AND
#     makes its email claim trustworthy for first-time auto-linking. 'common' /
#     'organizations' accept any work account, but then auto-linking also needs
#     a verified-email signal on the token (xms_edov / email_verified).
#   MS_REDIRECT_URI: must EXACTLY match the redirect URI registered on the Entra
#     app registration.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:4000/api/auth/sso/microsoft/callback

# ── AI provider (API key based) ─────────────────────────────────────────────
# AI drafts stories / acceptance-criteria / enhancements. Two transports, both
# using a plain API key. If NEITHER is configured, AI features are automatically
# hidden in the UI (no errors) — the app runs fully without AI.
#   anthropic → the Anthropic API directly (ANTHROPIC_API_KEY + CLAUDE_MODEL)
#   litellm   → ANY OpenAI-compatible endpoint / LiteLLM proxy
#   auto      → litellm if LITELLM_BASE_URL is set, else anthropic
CLAUDE_MODE=auto              # anthropic | litellm | auto (default)
# Anthropic (https://console.anthropic.com). A model id is REQUIRED for anthropic.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=                 # e.g. claude-sonnet-4-5
CLAUDE_TIMEOUT_MS=120000
CLAUDE_MAX_TOKENS=4096

# LiteLLM / OpenAI-compatible provider (CLAUDE_MODE=litellm, or auto when set).
# Base URL is the OpenAI-compatible root; the SDK appends /chat/completions.
# For image-to-story the model must be vision-capable; text flows work on any.
LITELLM_BASE_URL=             # e.g. https://litellm.mycompany.com
LITELLM_API_KEY=              # the proxy virtual key (sk-...)
LITELLM_MODEL=                # model/alias the proxy routes on (blank = CLAUDE_MODEL)
