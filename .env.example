# SPIREX — docker compose environment.
#   cp .env.example .env   then fill in the secrets below.
# This file configures the `docker compose up` stack. DATABASE_URL is computed
# by compose from the POSTGRES_* values, so you don't set it here.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=spirex
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=spirex

# ── App secrets (REQUIRED) ──────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32
ENCRYPTION_KEY=replace_me_with_openssl_rand_hex_32

# Public URL the app is served from (used in emails + SSO redirects). When this
# is https:// the auth cookie is automatically marked Secure; over http:// it is
# not (a Secure cookie won't round-trip over plain HTTP). Override: COOKIE_SECURE.
CLIENT_URL=http://localhost

# Expose the frontend on a different host port if 80 is taken.
FRONTEND_PORT=80

# ── First-run admin (REQUIRED on the first boot) ────────────────────────────
# On first boot with an empty database, SPIREX creates ONE admin account from
# these, plus its organization. Ignored once a user exists — change the password
# in-app after first login. The admin invites the rest of the team from there.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=Admin
DEFAULT_ORG_NAME=SPIREX

# ── AI provider (OPTIONAL) ──────────────────────────────────────────────────
# Set nothing here and AI features are simply hidden in the UI — the app runs
# fully without AI. To enable it, pick ONE:
#   Anthropic:  set ANTHROPIC_API_KEY + CLAUDE_MODEL
#   LiteLLM  :  set LITELLM_BASE_URL (+ LITELLM_API_KEY, LITELLM_MODEL)
CLAUDE_MODE=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=

# ── Email / SMTP (OPTIONAL) ─────────────────────────────────────────────────
# Blank SMTP_HOST disables email — invite links are returned in the API instead.
# Gmail: host=smtp.gmail.com port=465 secure=true, user=<gmail>, password=<App Password>.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SPIREX <no-reply@example.com>

# ── Microsoft SSO (OPTIONAL) ────────────────────────────────────────────────
# Blank = password login only. Redirect URI must match your Entra app registration.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost/api/auth/sso/microsoft/callback

# ── Storage (OPTIONAL) ──────────────────────────────────────────────────────
# Default 'local' keeps uploads on a docker volume. For object storage set
# STORAGE_DRIVER=minio and start with:  docker compose --profile minio up -d
STORAGE_DRIVER=local
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=spirex
MINIO_ACCESS_KEY=spirexminio
MINIO_SECRET_KEY=change_me_minio
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
