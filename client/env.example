# In dev the Vite server proxies /api to the backend (see vite.config.ts), so
# the app talks to the API same-origin and this value is ignored. Point the dev
# proxy elsewhere with VITE_API_PROXY_TARGET instead. In a production build the
# frontend is served by nginx which proxies /api to the server, so VITE_API_URL
# is typically left as the default '/api'.
VITE_API_URL=http://localhost:4000

# AGPL-3.0 §13: SPIREX shows an in-app "Source code" link so users interacting
# with it over the network can obtain the source of the running version. If you
# self-host a MODIFIED build, point this at YOUR fork so you stay compliant.
# Defaults to the canonical upstream repo when unset.
VITE_SOURCE_URL=https://github.com/your-org/spirex
